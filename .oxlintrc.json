{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["reflect-metadata", "**/*.css"]
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "request.**.expect", "http.**.expect", "send.expect"]
      }
    ],
    "eslint/no-underscore-dangle": [
      "warn",
      {
        "allow": ["_embedded", "_embed", "_fields", "_links"]
      }
    ]
  },
  "ignorePatterns": [".next", "coverage", "dist", "wordpress-plugin"]
}
