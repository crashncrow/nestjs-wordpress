{
  "name": "nestjs-wordpress",
  "version": "0.2.0",
  "description": "Use WordPress as a headless content source in NestJS: normalized DTOs, tag-based caching and signed webhooks.",
  "keywords": [
    "nestjs",
    "wordpress",
    "headless",
    "cms",
    "rest-api",
    "bff"
  ],
  "license": "MIT",
  "author": "crashncrow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crashncrow/nestjs-wordpress.git",
    "directory": "packages/nestjs-wordpress"
  },
  "homepage": "https://github.com/crashncrow/nestjs-wordpress#readme",
  "bugs": "https://github.com/crashncrow/nestjs-wordpress/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "cacheable": "^2.5.0"
  },
  "peerDependencies": {
    "@keyv/redis": "^5.1.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@keyv/redis": {
      "optional": true
    },
    "@nestjs/event-emitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@keyv/redis": "^5.1.6",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@types/supertest": "^7.2.1",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5",
    "wp-types": "^4.71.0"
  }
}
