{
  "name": "demo",
  "version": "0.0.0",
  "private": true,
  "description": "Example NestJS app consuming nestjs-wordpress (BFF pattern).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
