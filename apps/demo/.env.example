# Copy to .env, or run `pnpm wp:seed`, which generates it with a fresh application password.
PORT=3000
WP_URL=http://localhost:8080
WP_USERNAME=admin
WP_APP_PASSWORD=
WP_WEBHOOK_SECRET=dev-webhook-secret-change-me
REDIS_URL=redis://localhost:6379
# Optional: cache key prefix (e2e tests set a unique one per run).
# CACHE_NAMESPACE=nestjs-wordpress-demo
